# Service
APP_ENV=development
STUB_MODE=true

# Default tenant (v1 single-tenant config)
DEFAULT_TENANT_ID=default

# Tools endpoint (Sprint 3)
TOOLS_URL=http://localhost:8002
TOOLS_MODE=simulate
LLM_STUB=true

# Fonada FAISS knowledge-base API (Sprint 4)
# SECURITY: use a client/agent API key only — never the admin key.
KB_BASE_URL=https://api.fonada.ai
KB_API_KEY=
KB_SEARCH_PATH=/search
KB_USER_AGENT=Supabase-Function/1.0
KB_TOP_K=10
KB_VERIFY_SSL=true
KB_STUB=true

# Vertex AI / Gemini (Sprint 4b)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-sa.json
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GEMINI_MODEL_ID=gemini-3.5-flash
# minimal|low|medium|high (3.x); on 2.5 "minimal" maps to thinking_budget=0
GEMINI_THINKING_LEVEL=minimal

# ari-orchestrator (call control: consult hold, warm transfer)
ORCHESTRATOR_BASE_URL=http://127.0.0.1:8095
# Warm transfer (transfer_call): human agent dialled for the handoff. The
# legacy voip.ivrobd.com transfer endpoint is REMOVED — orchestrator only.
TRANSFER_AGENT_NUMBER=
# Hold before dialling so the handoff line plays first; ring budget; beat
# between agent joining the three-way and the AI leg being dropped.
TRANSFER_HOLD_MS=4500
TRANSFER_ANSWER_BUDGET_S=30
TRANSFER_COMPLETE_DELAY_MS=1500
# Spoken when the agent leg does not answer (tenants may override in TenantConfig).
TRANSFER_NO_ANSWER_REPLY=

STATE_TTL_SECONDS=14400

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local Postgres borrower lookup (test stack — docker compose postgres service).
# Conversation state uses memory stub unless Upstash is configured above.
BORROWER_DATABASE_URL=
DATABASE_URL=
# Example (server compose): postgresql://collections:YOUR_PASSWORD@postgres:5432/collections

# Tenant compliance defaults
CALL_WINDOW_START=08:00
CALL_WINDOW_END=19:00
CALL_WINDOW_TIMEZONE=Asia/Kolkata
MAX_ATTEMPTS_PER_DAY=3
MAX_ATTEMPTS_PER_WEEK=7

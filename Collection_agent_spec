```

### 6.4 Flow schema (authored YAML; retrieved from KB)

```yaml
# app/flows/promise_to_pay.yml
flows:
  promise_to_pay:
    description: >        # plain-English; this is what retrieval matches on
      Borrower agrees to pay on a future date ("kal", "parso", "next week").
    priority: ptp         # maps to priority engine ladder
    steps:
      - collect: ptp_date
      - action: validate_ptp          # tool/logic → sets ptp_allowed
        next:
          - if: "ptp_allowed == true"
            then: accept
          - else: counter
      - id: accept
        utter: confirm_ptp
        next: schedule
      - id: schedule
        action: schedule_followup
        next: end
      - id: counter
        utter: ask_earlier_date
responses:
  confirm_ptp:
    - text: "Theek hai sir, {ptp_date} note kar liya. Us din tak {amount_due} jama karna hoga."
  ask_earlier_date:
    - text: "Itni der mushkil hai sir. Is hafte tak kuch ho sakta hai?"
```


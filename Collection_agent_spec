## 6. Data contracts (the interfaces everything depends on — build in Sprint 0/1)

### 6.1 Engine API — `POST /turn`

```python
# app/schemas/api.py
class TurnRequest(BaseModel):
    call_id: str                  # conversation/session id (one live call)
    tenant_id: str                # which lender/config (multi-tenant ready)
    borrower_id: str              # durable borrower key (memory lookup)
    channel: Literal["voice","whatsapp"] = "voice"
    transcript: str               # FINAL ASR text for this turn
    locale: str = "hi-IN"         # language hint
    turn_meta: dict = {}          # optional: asr_confidence, ts, etc.

class TurnResponse(BaseModel):
    reply_text: str               # GATED text for TTS ("" => say nothing / end)
    end_call: bool = False
    transfer_to_human: bool = False
    actions_executed: list[str] = []   # names of tools run this turn
    disposition: str | None = None     # e.g. PTP_CAPTURED, DISPUTE_RAISED
    state_version: int                 # optimistic-concurrency marker
    audit_id: str                      # id of the audit record for this turn
```

### 6.2 Command vocabulary (the LLM's ONLY allowed output)

```python
# app/schemas/command.py
class Command(BaseModel):
    command: Literal["start_flow","set_slot","cancel_flow",
                     "clarify","human_handoff","cannot_handle"]
    flow: str | None = None
    name: str | None = None        # for set_slot
    value: Any | None = None
    reason: str | None = None
# The model may emit MULTIPLE commands per turn. Anything outside this set is rejected.
```

### 6.3 Conversation state + borrower memory (Upstash)

```python
# app/schemas/state.py
class Frame(BaseModel):
    flow: str
    step_index: int = 0
    parked: bool = False           # for priority park/resume

class Event(BaseModel):            # append-only audit element
    ts: str
    kind: str                      # command|action|decision|gate|persona|emotion|...
    data: dict
    rationale: str | None = None

class ConversationState(BaseModel):      # LIVE call state (Redis, TTL ~ hours)
    call_id: str
    tenant_id: str
    borrower_id: str
    slots: dict = {}               # amount_due, dpd, ptp_date, ptp_allowed, ...
    flow_stack: list[Frame] = []
    events: list[Event] = []       # this call's events (also streamed to audit)
    attempts: int = 0
    version: int = 0

class BorrowerRecord(BaseModel):         # DURABLE memory (14 blocks, blueprint §12)
    borrower_id: str
    identity: dict                 # masked contact, language, kyc_status
    loan: dict                     # loan_id, principal, emi, due_date, outstanding, dpd, bucket
    payments: list[dict] = []
    ptps: list[dict] = []          # made_on, promised_date, amount, status
    broken_ptps: list[dict] = []
    excuses: list[dict] = []
    emotions: list[dict] = []
    hardships: list[dict] = []
    disputes: list[dict] = []
    trust_current: int = 50
    trust_history: list[dict] = []
    recovery: dict = {}            # p_cure, expected_pv
    comms_prefs: dict = {}         # channel, time window, language, consent, DNC
    compliance_flags: dict = {}    # vulnerable, harassment_complaint, third_party_block,
